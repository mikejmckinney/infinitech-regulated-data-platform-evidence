                  }
                ]
              },
              {
                "uuid": "b42c7136-319e-5764-9a44-8f8b57ebbc26",
                "control-id": "ac-6",
                "description": "Key administration is delegated to IAM in the owning account, and CloudWatch Logs may use a key only for log groups in that account. Consumers get a policy per classification and consumer that allows key use only through one AWS service (kms:ViaService) in the deployment's region.",
                "props": [
