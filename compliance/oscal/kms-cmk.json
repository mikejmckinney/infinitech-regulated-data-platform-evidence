              },
              {
                "uuid": "ec203615-b307-5f1d-8aa0-b2b8c63d077b",
                "control-id": "sc-28.1",
                "description": "Data at rest is encrypted with the key for its classification. The module refuses a \"public\" classification, so no regulated resource can be pointed at an unclassified key.",
                "props": [
                  {
                    "name": "control-title",
                    "ns": "https://infinitechplatforms.com/ns/irdp",
                    "value": "Cryptographic Protection"
                  }
                ],
                "links": [
