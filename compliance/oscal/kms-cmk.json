            "uuid": "38c5053f-4e2d-5c8e-aee4-d55406a74fb3",
            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/v1.6.0/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "description": "How the KMS customer-managed keys per data classification component implements NIST SP 800-53 Rev. 5.2.0 controls.",
            "implemented-requirements": [
              {
                "uuid": "1870162d-941b-543b-ab84-25ccf4222d75",
                "control-id": "sc-12",
                "description": "Each classification gets its own customer-managed key with automatic rotation on. The rotation period is limited to 90 to 2,560 days and the deletion window to 7 to 30 days. Keys in a custom key store (CloudHSM) can't be rotated automatically, so for those the module turns rotation off and reports it as manual.",
                "props": [
                  {
                    "name": "control-title",
                    "ns": "https://infinitechplatforms.com/ns/irdp",
                    "value": "Cryptographic Key Establishment and Management"
                  }
                ],
